DATABASE_URL="postgresql://user:password@localhost:5432/veent_hris"
LUCIA_SECRET="change-me-to-a-random-32-char-string"
NODE_ENV="development"
PORT=3000

# ─── Discord time-tracking integration ───────────────────────────────────────
# Shared HMAC secret between the HRIS /api/v1/timesheets/log endpoint and the bot.
TIMELOG_API_SECRET="change-me-to-a-random-32-char-string"
# Discord bot (only needed to run `pnpm bot`, not the web app). Slash commands /in /out
# are registered to every guild the bot joins — no channel/guild id needed.
DISCORD_BOT_TOKEN=""
HRIS_API_URL="http://localhost:5173"

# ─── Document backup (#164) ──────────────────────────────────────────────────
# Where nightly document backups are written when the destination kind is LOCAL.
# MUST NOT be inside UPLOAD_DIR (or contain it) — the script refuses to start otherwise.
BACKUP_DIR="./backups"
# S3-compatible destination (kind = S3). Endpoint is the full origin, e.g.
# https://sgp1.digitaloceanspaces.com or https://s3.ap-southeast-1.amazonaws.com.
# These are read ONLY from the environment — they are never stored in the database and
# never rendered in the UI, so a database dump cannot leak the bucket.
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION=""
BACKUP_S3_BUCKET=""
BACKUP_S3_PREFIX="veent-hris"
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""

# ─── Outbound email (#178) ───────────────────────────────────────────────────
# Every send* in src/lib/server/notifications.ts goes through src/lib/server/mailer.ts.
# SMTP_HOST ABSENT = unconfigured = a [NOTIFY] console line instead of a send, and nothing
# throws. That line masks the recipient's local part and keeps the domain and the subject.
# That is the normal state for local development, not an error.
SMTP_HOST=""
# 587 with STARTTLS is the default; use 465 with SMTP_SECURE="true" for implicit TLS.
SMTP_PORT="587"
SMTP_SECURE="false"
# Omit USER and PASS together for an unauthenticated relay. NEVER commit a real password.
SMTP_USER=""
SMTP_PASS=""
# From address. Defaults to SMTP_USER when empty.
SMTP_FROM=""
