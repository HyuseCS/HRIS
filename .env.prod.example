# Production env — consumed by Docker at runtime via `docker run --env-file .env.prod`.
# IMPORTANT: no quotes. Docker's --env-file parses literal KEY=value; quotes become
# part of the value. (This differs from .env.dev, which dotenv-cli loads and unquotes.)
#
# Copy this file to .env.prod and fill in real values. .env.prod is gitignored.

# ─── Database ────────────────────────────────────────────────────────────────
# docker-compose starts a Postgres service named `db`; the app reaches it at host
# `db` (the compose service name), NOT localhost. POSTGRES_* configure that
# container, and DATABASE_URL must use the SAME user / password / db name.
POSTGRES_USER=veent
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
POSTGRES_DB=veent_hris
DATABASE_URL=postgresql://veent:REPLACE_WITH_DB_PASSWORD@db:5432/veent_hris

# Generate with: openssl rand -base64 32
LUCIA_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

NODE_ENV=production
PORT=3000

# Required by @sveltejs/adapter-node in production, or cross-origin form POSTs
# fail CSRF checks. Set to the public URL the app is served from.
ORIGIN=https://hris.example.com

# Must match the secret the Discord bot signs requests with.
# Generate with: openssl rand -hex 32
TIMELOG_API_SECRET=REPLACE_WITH_RANDOM_64_HEX

# Discord bot — only needed if you run `pnpm bot` in production.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
HRIS_API_URL=https://hris.example.com

# ─── Document storage ────────────────────────────────────────────────────────
# Where document bytes are stored. MUST be a mounted volume (see docker-compose.yml).
# Without one, every 201 file lives inside the container and is destroyed by the next
# `docker compose up`.
UPLOAD_DIR=/app/uploads

# ─── Document backup (#164) ──────────────────────────────────────────────────
# LOCAL destination. Must also be a mounted volume, or the backup dies with the
# `--rm` container it was written into. MUST NOT be inside UPLOAD_DIR.
BACKUP_DIR=/app/backups
# S3-compatible destination — only needed when the org's destination kind is S3.
# Never stored in the database; never shown in the UI.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=veent-hris
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ─── Outbound email (#178) ───────────────────────────────────────────────────
# Without SMTP_HOST the droplet sends no email at all — every notification degrades to
# a [NOTIFY] log line and nothing fails. Set these to actually deliver.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
