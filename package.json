{
	"name": "veent-hris",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=20.12"
	},
	"scripts": {
		"postinstall": "prisma generate",
		"dev": "dotenv -e .env.dev -- vite dev",
		"build": "vite build",
		"preview": "dotenv -e .env.dev -- vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "dotenv -e .env.dev -- playwright test",
		"test:integration": "dotenv -e .env.dev -- vitest run --config vitest.integration.config.ts",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:migrate": "dotenv -e .env.dev -- prisma db push",
		"db:push": "dotenv -e .env.dev -- prisma db push",
		"db:seed": "dotenv -e .env.dev -- tsx prisma/seed.ts",
		"db:seed:e2e": "dotenv -e .env.dev -- tsx prisma/seed-e2e.ts",
		"db:seed:templates": "dotenv -e .env.dev -- tsx prisma/seed-performance-templates.ts",
		"db:studio": "dotenv -e .env.dev -- prisma studio",
		"prisma": "dotenv -e .env.dev -- prisma",
		"bot": "dotenv -e .env.dev -- tsx scripts/discord-bot.ts",
		"prod-delete": "tsx scripts/prod-delete.ts"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@playwright/test": "^1.49.0",
		"@sveltejs/adapter-node": "^5.2.0",
		"@sveltejs/kit": "^2.8.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/svelte": "^5.2.0",
		"@types/bcrypt": "^5.0.2",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^22.0.0",
		"@types/nodemailer": "^8.0.1",
		"@types/papaparse": "^5.5.2",
		"@types/pdfkit": "^0.17.6",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"autoprefixer": "^10.4.0",
		"dotenv": "^17.4.2",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-svelte": "^2.46.0",
		"globals": "^17.7.0",
		"postcss": "^8.4.0",
		"prettier": "^3.3.0",
		"prettier-plugin-svelte": "^3.2.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-eslint-parser": "^1.8.0",
		"tailwindcss": "^3.4.0",
		"typescript": "^5.6.0",
		"vite": "^5.4.0",
		"vitest": "^2.1.0"
	},
	"dependencies": {
		"@lucia-auth/adapter-prisma": "^4.0.1",
		"@prisma/client": "^5.22.0",
		"bcrypt": "^5.1.1",
		"bits-ui": "^0.21.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.0",
		"discord.js": "^14.26.4",
		"layerchart": "^2.0.1",
		"leaflet": "^1.9.4",
		"lucia": "^3.2.0",
		"lucide-svelte": "^0.460.0",
		"nodemailer": "^9.0.5",
		"papaparse": "^5.6.0",
		"pdfkit": "^0.19.1",
		"prisma": "^5.22.0",
		"tailwind-merge": "^2.5.0",
		"tsx": "^4.19.0",
		"zod": "^3.23.0"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"bcrypt",
			"esbuild",
			"prisma"
		]
	}
}
