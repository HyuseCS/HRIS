generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Lucia Auth ──────────────────────────────────────────────────────────────

model Session {
  id           String   @id
  userId       String
  expiresAt    DateTime
  // Active org for cross-org members (#131). Null → fall back to User.organizationId.
  // Set at login to the user's primary org; changed only via the validated
  // /api/v1/session/switch-org endpoint.
  currentOrgId String?
  user         User     @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("sessions")
}

// ─── Core HR Enums ───────────────────────────────────────────────────────────

enum Role {
  EMPLOYEE
  MANAGER
  HR_ADMIN
  SUPER_ADMIN
  PAYROLL_OFFICER
  FINANCE
  CEO
  VERIFIER
  APPROVER
}

enum EmploymentType {
  // FULL_TIME was renamed to REGULAR (#172) — payslips already printed it as "REGULAR", so the
  // data model now matches the document. Renaming a Postgres enum value is NOT something
  // `prisma db push` can do without dropping the type, so any existing database must run
  // `pnpm tsx scripts/migrate-employment-type-regular.ts` BEFORE the push.
  REGULAR
  PART_TIME
  CONTRACTUAL
  PROBATIONARY
  // #187: branch crew who work called shifts, and interns.
  ON_CALL
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  OFFBOARDED
}

// #122 removed DAILY on the basis that staff are either salaried or hourly; #189 reverses that
// and restores it. Adding an enum value is something `db push` handles on its own — unlike the
// FULL_TIME → REGULAR rename, no migration script is needed.
//
// HOURLY is restricted to PART_TIME and ON_CALL staff (#189); the rate/type pairing is enforced
// in `$lib/utils/rate-basis`, which the create form, the edit form and the API all validate with.
enum RateType {
  MONTHLY
  DAILY
  HOURLY
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestType {
  LEAVE
  OVERTIME
  UNDERTIME
  OFFICIAL_BUSINESS
  REST_DAY_WORK
  HOLIDAY_WORK
  INFO_UPDATE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

// A stage is either the employee's direct supervisor (reportsTo) or a named role group.
enum ApprovalStageKind {
  SUPERVISOR
  ROLE
}

// Three-stage maker-checker chain (#134): a request is MADE (HR/Manager), VERIFIED
// (Verifier), then APPROVED (Approver). Existing rows default to APPROVE — under the
// old routing model every decided step was the terminal approval.
enum ApprovalStage {
  MAKE
  VERIFY
  APPROVE
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  RETURNED
}

enum PayrollRunStatus {
  DRAFT
  COMPUTED
  APPROVED
  VOIDED
}

enum PayFrequency {
  SEMI_MONTHLY
  MONTHLY
}

enum PayrollPeriodStatus {
  OPEN
  IMPORTED
  GENERATED
  LOCKED
  RELEASED
  VOIDED
}

enum LoanStatus {
  ACTIVE
  PAID
  CANCELLED
}

enum JobPostingStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  CLOSED
}

enum ApplicantStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewMode {
  ONSITE
  VIDEO
  PHONE
}

enum OfferStatus {
  SENT
  ACCEPTED
  DECLINED
}

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
  // #199: a declared Special *Working* holiday is paid as an ordinary working day — no premium
  // (cf. SPECIAL_NON_WORKING at +30%). Attendance maps it back to the schedule-based day type.
  SPECIAL_WORKING
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGIN_FAILED
  PAYROLL_OVERRIDE
  LEAVE_OVERRIDE
  // #298: a payroll void used to log as a plain UPDATE, indistinguishable from every other edit
  // in the audit filter. Its own action makes it findable from the action dropdown without
  // revealing any payload — the #242 mask blanks oldValue/newValue on that page.
  PAYROLL_VOID
  // #304: an undo of a finalized separation. Same argument PAYROLL_VOID made — a generic UPDATE is
  // unfindable in the audit action filter, and a break-glass door that reverses money, offboarding
  // and a login must be findable from the dropdown. Adding an enum value is `db push`-safe; only a
  // RENAME drops and recreates the type, which is what would have needed a scripts/migrate-*.ts.
  SEPARATION_UNDO
}

// ─── Time Tracking Enums ─────────────────────────────────────────────────────

enum PunchType {
  IN
  OUT
  BREAK_START
  BREAK_END
}

enum PunchSource {
  DISCORD
  WEB
  MANUAL
}

// ─── Benefits Enums ──────────────────────────────────────────────────────────

enum BenefitPlanType {
  HMO
  INSURANCE
  RETIREMENT
  ALLOWANCE
  LEAVE_CREDIT
  OTHER
}

enum BenefitEnrollmentStatus {
  ACTIVE
  WAIVED
  TERMINATED
}

// ─── Performance Enums ───────────────────────────────────────────────────────

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ReviewStatus {
  PENDING
  SELF_ASSESSMENT
  SCORED
  SIGNING
  COMPLETED
  ACKNOWLEDGED
}

// ─── Attendance Enums ────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  INCOMPLETE
  ON_LEAVE
  HOLIDAY
  REST_DAY
}

enum DayType {
  REGULAR
  REST_DAY
  REGULAR_HOLIDAY
  SPECIAL_HOLIDAY
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Organization {
  id                   String   @id @default(cuid())
  name                 String   @db.VarChar(200)
  logoUrl              String?
  // Per-tenant brand colour as a raw HSL triple ("H S% L%", e.g. "142 71% 42%") so it can
  // be injected straight into the `--primary`/`--ring` CSS variables. Null → default palette.
  themePrimary         String?
  address              String?
  // Company Discord server invite link (#186). When set, onboarding emails new hires an
  // invitation; null (most tenants) skips it. Only Veent has adopted Discord so far.
  discordInviteUrl     String?
  // Prefix for generated employee numbers ("EMP" → EMP-015). Per-org because the branches
  // number their staff separately: JoJo Potato uses JJ, Sweetleaf SL. The default backfills
  // existing rows and keeps Veent on EMP.
  employeeNumberPrefix String   @default("EMP") @db.VarChar(8)
  // Master switch for schedule-based tardiness (#190). Off → no employee is ever marked LATE,
  // company-wide; ANDs with each WorkSchedule.trackTardiness. Default keeps current behavior.
  trackTardiness       Boolean  @default(true)
  // Smallest gap between two work blocks that counts as the AM/PM boundary, in minutes (#162).
  // NULL → use the built-in default (DEFAULT_AM_PM_MIN_GAP_MINUTES in attendance/derive.ts).
  // Only read when the org is food-service (isFoodServiceOrg) — it is a tuning knob, never a
  // gate. Bounded 5–240 at every writer; a value outside that range cannot be stored.
  amPmMinGapMinutes    Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  departments               Department[]
  users                     User[]
  memberships               UserOrganization[]
  leaveTypes                LeaveType[]
  payrollConfig             PayrollConfig?
  payrollRuns               PayrollRun[]
  jobPostings               JobPosting[]
  publicHolidays            PublicHoliday[]
  auditLogs                 AuditLog[]
  benefitPlans              BenefitPlan[]
  reviewCycles              ReviewCycle[]
  positions                 Position[]
  payrollPeriods            PayrollPeriod[]
  earningTypes              EarningType[]
  deductionTypes            DeductionType[]
  payRateRule               PayRateRule?
  statutoryRateConfig       StatutoryRateConfig?
  statutoryRateProposals    StatutoryRateProposal[]
  actionProposals           ActionProposal[]
  workSchedules             WorkSchedule[]
  salaryGrades              SalaryGrade[]
  announcements             Announcement[]
  onboardingChecklistItems  OnboardingChecklistItem[]
  offboardingChecklistItems OffboardingChecklistItem[]
  postingApprovers          PostingApprover[]
  jobBoards                 JobBoard[]
  inventoryItems            InventoryItem[]
  branches                  Branch[]
  backupConfig              BackupConfig?
  backupRuns                BackupRun[]
  performanceTemplates      PerformanceTemplate[]
  performanceConfig         PerformanceConfig?

  @@map("organizations")
}

// Cross-org membership (#131) — a user can belong to more than one Organization.
// Populated at seed time for every user (one row per primary org); CEO gets one
// row per tenant. `User.organizationId` remains the user's primary org for
// backwards-compat with everything that still passes it explicitly; the session
// carries `currentOrgId` which points at whichever membership is active.
model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_organizations")
}

// ─── Department ───────────────────────────────────────────────────────────────

model Department {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String   @db.VarChar(200)
  parentDepartmentId String?
  // #178: who attests the DEPARTMENT_HEAD signatory slot. Postgres cannot express
  // "head.departmentId == this department", so the service layer verifies it on write —
  // the same rule Employee.reportsToId and Employee.branchId already carry.
  //
  // WHY THIS COLUMN EXISTS AT ALL: the paper forms require a Department Head signature and
  // this schema had no way to name one. Without it, EVERY review under either seeded template
  // would be permanently stalled and the "resolving the gap unblocks it" case would be
  // untestable.
  headEmployeeId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id])
  head             Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  parentDepartment Department?  @relation("DeptHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments   Department[] @relation("DeptHierarchy")
  employees        Employee[]
  jobPostings      JobPosting[]
  positions        Position[]
  offers           Offer[]

  @@unique([organizationId, name])
  @@map("departments")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String    @unique
  passwordHash   String
  // `roles` is the user's whole role set, e.g. [MANAGER, VERIFIER]. Capability checks
  // match ANY role in it. There is no primary role — the scalar `role` was dropped in
  // #282, and every guard resolves authority from the set alone.
  roles          Role[]    @default([])
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization             Organization         @relation(fields: [organizationId], references: [id])
  memberships              UserOrganization[]
  sessions                 Session[]
  employee                 Employee?
  auditLogs                AuditLog[]
  approvalSteps            ApprovalStep[]
  uploadedDocuments        EmployeeDocument[]   @relation("DocumentUploader")
  verifiedRequestDocuments RequestDocument[]    @relation("RequestDocumentVerifier")
  notifications            Notification[]
  announcements            Announcement[]       @relation("AnnouncementAuthor")
  complaintsOpened         HrComplaint[]        @relation("ComplaintOpenedBy")
  complaintMessages        HrComplaintMessage[] @relation("ComplaintMessageAuthor")
  reviewSignoffs           ReviewSignoff[]

  @@map("users")
}

// ─── Employee ─────────────────────────────────────────────────────────────────

model Employee {
  id                       String           @id @default(cuid())
  userId                   String           @unique
  organizationId           String
  employeeNumber           String
  firstName                String
  lastName                 String
  middleName               String?
  dateOfBirth              DateTime?
  gender                   Gender?
  contactPhone             String?
  contactAddress           String?
  departmentId             String
  jobTitle                 String
  employmentType           EmploymentType
  employmentStatus         EmploymentStatus @default(ACTIVE)
  // Company email (#186). Real provisioning is deferred, so onboarding seeds this with the
  // hire's working email; HR updates it to the real company address once provisioned.
  companyEmail             String?
  startDate                DateTime
  endDate                  DateTime?
  // Primary manager. Postgres cannot express "reportsTo.organizationId == this employee's", so
  // every service-layer writer verifies it (#235) — `assertManagerInOrg` in services/employees.ts.
  reportsToId              String?
  positionId               String?
  workScheduleId           String?
  // Store assignment. Nullable: only the food-service tenants use branches, and an employee
  // can be unassigned (head office, new hire, floater). Postgres cannot express
  // "branch.organizationId == employee.organizationId", so every write path to this column
  // must verify it in the service layer (updateEmployee and branches.normalize both do).
  branchId                 String?
  discordId                String?          @unique
  basicMonthlySalary       Decimal          @db.Decimal(12, 2)
  rateType                 RateType         @default(MONTHLY)
  sssNumber                String?
  philhealthNumber         String?
  pagibigNumber            String?
  tinNumber                String?
  // Emergency contact (personal — visible to the employee's managers). Kept as quick
  // inline fields alongside the richer EmergencyContact child table (see relation below).
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  // Disbursement details — sensitive PII, HR-only (FR-048). Nulled for non-HR viewers.
  bankName                 String?
  bankAccountName          String?
  bankAccountNumber        String?
  gcashNumber              String?
  // #178: the template this employee is evaluated with. EXPLICIT and HR-set — never inferred
  // from department, position, or role. Nullable: an unassigned employee lands on the HR
  // "cannot be reviewed" list with a reason, rather than silently getting a default form.
  assignedTemplateId       String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  user                  User                      @relation(fields: [userId], references: [id])
  department            Department                @relation(fields: [departmentId], references: [id])
  position              Position?                 @relation(fields: [positionId], references: [id])
  reportsTo             Employee?                 @relation("EmployeeHierarchy", fields: [reportsToId], references: [id])
  directReports         Employee[]                @relation("EmployeeHierarchy")
  timesheets            Timesheet[]
  timeLogs              TimeLog[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  requests              Request[]
  documents             EmployeeDocument[]
  payrollEntries        PayrollEntry[]
  convertedApplicant    Applicant?                @relation("ConvertedEmployee")
  benefitEnrollments    BenefitEnrollment[]
  performanceReviews    PerformanceReview[]       @relation("ReviewSubject")
  reviewsGiven          PerformanceReview[]       @relation("Reviewer")
  loans                 Loan[]
  cashAdvances          CashAdvance[]
  recurringEarnings     EmployeeEarning[]
  recurringDeductions   EmployeeDeduction[]
  statutoryConfig       EmployeeStatutoryConfig[]
  compensationHistory   EmployeeCompensation[]
  employmentTypeHistory EmployeeEmploymentType[]
  actionProposals       ActionProposal[]
  workSchedule          WorkSchedule?             @relation(fields: [workScheduleId], references: [id])
  attendanceDays        AttendanceDay[]
  separations           SeparationRecord[]
  emergencyContacts     EmergencyContact[]
  complaints            HrComplaint[]
  onboardingCompletions OnboardingCompletion[]
  assignedInventory     InventoryItem[]
  branch                Branch?                   @relation("BranchRoster", fields: [branchId], references: [id], onDelete: SetNull)
  managedBranches       Branch[]                  @relation("BranchManager")
  assignedTemplate      PerformanceTemplate?      @relation("AssignedTemplate", fields: [assignedTemplateId], references: [id])
  releasedReviews       PerformanceReview[]       @relation("ReviewReleasedBy")
  headedDepartments     Department[]              @relation("DepartmentHead")

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, branchId])
  @@map("employees")
}

// #170/#171: effective-dated compensation snapshots. Each row is the FULL comp
// ({basicMonthlySalary, rateType}) in effect from `effectiveDate`. `Employee.{basicMonthlySalary,
// rateType}` stay the authoritative "current" cache (== the snapshot with the latest effectiveDate
// ≤ today); this table is authoritative only for "as of date X", which the payroll engine reads to
// split a run across a mid-period change. Future-dating is allowed: cache re-derivation is bounded to
// effectiveDate ≤ today and healed on read (getEmployee), so a future row stays dormant until its date
// arrives — no scheduler needed. Actor id is a plain String (no User relation) per StatutoryRateProposal precedent.
model EmployeeCompensation {
  id                 String   @id @default(cuid())
  employeeId         String
  basicMonthlySalary Decimal  @db.Decimal(12, 2)
  rateType           RateType
  effectiveDate      DateTime
  note               String?
  changedById        String
  changedAt          DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveDate])
  @@map("employee_compensation_history")
}

// #222: effective-dated employment-type snapshots — the same shape and contract as
// EmployeeCompensation above, so a promotion dated next Monday moves title, pay AND status on that
// date rather than the moment HR typed it. `Employee.employmentType` stays the current cache (== the
// snapshot with the latest effectiveDate ≤ today), healed on read; this table is authoritative for
// "as of date X". Nothing in payroll math reads employment type (payslip label, dashboard alerts and
// the rate-basis pairing do), so unlike comp it has no period resolver — just the as-of read.
model EmployeeEmploymentType {
  id             String         @id @default(cuid())
  employeeId     String
  employmentType EmploymentType
  effectiveDate  DateTime
  note           String?
  changedById    String
  changedAt      DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveDate])
  @@map("employee_employment_type_history")
}

// Additional (secondary) supervisors (#176). An employee's primary manager stays on
// Employee.reportsToId; this records the extra superiors they also report to, so team
// rosters and manager views count someone under ANY of their supervisors. Plain employee-id
// FKs (resolved in queries) keep it off the Employee relation graph.
model EmployeeSupervisor {
  id           String   @id @default(cuid())
  employeeId   String
  supervisorId String
  createdAt    DateTime @default(now())

  @@unique([employeeId, supervisorId])
  @@index([supervisorId])
  @@index([employeeId])
  @@map("employee_supervisors")
}

// Emergency contact(s) on the 201 file (FR-047). An employee may have several.
model EmergencyContact {
  id           String   @id @default(cuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("emergency_contacts")
}

// Per-employee statutory enrollment (#173). One row per contribution the employee has been
// individually exempted from — absence of a row means enrolled (the default). Designed to grow:
// later features add employer-share/period-allocation columns alongside `exempt`.
enum StatutoryContribution {
  SSS
  PHILHEALTH
  PAGIBIG
}

// #173 (Feature E): which semi-monthly cutoff the EMPLOYEE share is deducted on. EVEN splits it
// half-and-half (today's proration); FIRST takes the full monthly EE on the 1–15 cutoff, SECOND on
// the 16–EOM cutoff. Employer share and tax keep their normal proration regardless.
enum StatutoryAllocation {
  EVEN
  FIRST
  SECOND
}

model EmployeeStatutoryConfig {
  id                          String                @id @default(cuid())
  employeeId                  String
  contribution                StatutoryContribution
  exempt                      Boolean               @default(false)
  // #173 (Feature C): employer share is remitted elsewhere (e.g. primary employer / dual
  // employment) — zero the ER share only; the EE share is still deducted. Independent of `exempt`.
  employerSharePaidExternally Boolean               @default(false)
  // #173 (Feature E): per-employee EE-share cutoff choice. Default EVEN = today's behaviour.
  allocation                  StatutoryAllocation   @default(EVEN)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  employee                    Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, contribution])
  @@map("employee_statutory_config")
}

// ─── Timesheet ────────────────────────────────────────────────────────────────

model Timesheet {
  id              String          @id @default(cuid())
  employeeId      String
  periodStart     DateTime
  periodEnd       DateTime
  status          TimesheetStatus @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  totalHours      Decimal         @default(0) @db.Decimal(5, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  employee      Employee         @relation(fields: [employeeId], references: [id])
  entries       TimesheetEntry[]
  timeLogs      TimeLog[]
  approvalSteps ApprovalStep[]

  @@unique([employeeId, periodStart])
  @@map("timesheets")
}

model TimesheetEntry {
  id          String    @id @default(cuid())
  timesheetId String
  date        DateTime
  timeIn      DateTime?
  timeOut     DateTime?
  hoursWorked Decimal   @db.Decimal(4, 2) // total worked (regular + OT)
  otHours     Decimal   @default(0) @db.Decimal(4, 2) // portion outside the 08:00–17:00 window
  notes       String?

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@map("timesheet_entries")
}

// ─── Leave ────────────────────────────────────────────────────────────────────

model LeaveType {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  isPaid             Boolean  @default(true)
  defaultDaysPerYear Decimal  @db.Decimal(5, 2)
  allowCarryOver     Boolean  @default(false)
  maxCarryOverDays   Decimal? @db.Decimal(5, 2)
  isActive           Boolean  @default(true)
  // Tenure gate (#137). Filing is blocked until the employee has this many whole calendar
  // months of service. 0 = available from day one (every type except SIL, which the Labor
  // Code makes a 1-year entitlement). Kept as data rather than a name check so renaming a
  // type in Settings can't silently switch a statutory gate off.
  minMonthsOfService Int      @default(0)

  organization  Organization   @relation(fields: [organizationId], references: [id])
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@unique([organizationId, name])
  @@map("leave_types")
}

model LeaveBalance {
  id          String  @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Decimal @db.Decimal(5, 2)
  used        Decimal @default(0) @db.Decimal(5, 2)
  remaining   Decimal @db.Decimal(5, 2)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

// Onboarding checklist (#116). Org-scoped, ordered list HR configures in Settings.
// DERIVED items are auto-checked from the employee's own 201-file record via a fixed
// `derivedKey` (the "done" logic stays in code); MANUAL items are ticked off by HR and
// their completion is stored per employee in OnboardingCompletion. When an org has no
// rows configured, the 201 file falls back to the built-in default derived steps.
enum OnboardingItemKind {
  DERIVED
  MANUAL
}

model OnboardingChecklistItem {
  id             String             @id @default(cuid())
  organizationId String
  kind           OnboardingItemKind
  // Non-null only for DERIVED items — identifies which built-in condition checks it off.
  derivedKey     String?
  label          String
  hint           String             @default("")
  order          Int
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  completions  OnboardingCompletion[]

  // A given derived condition is configured at most once per org.
  @@unique([organizationId, derivedKey])
  @@index([organizationId])
  @@map("onboarding_checklist_items")
}

model OnboardingCompletion {
  id            String   @id @default(cuid())
  itemId        String
  employeeId    String
  completedAt   DateTime @default(now())
  completedById String?

  item     OnboardingChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  employee Employee                @relation(fields: [employeeId], references: [id])

  @@unique([itemId, employeeId])
  @@index([employeeId])
  @@map("onboarding_completions")
}

// Offboarding checklist template (#192). Org-scoped, ordered list HR configures in
// Settings, the mirror of the onboarding checklist. Each item names a clearance task and
// the department that signs it off; opening a separation copies the active items into that
// case's ClearanceItem rows, and the transition notice email (#185) lists them. An org
// that has never configured one falls back to the built-in defaults.
// Employee award / recognition (#180). HR grants these; they announce on the dashboard
// feed and notify the recipient. Plain org/employee id FKs (resolved in queries) keep it
// off the Employee relation graph.
model Award {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  title          String
  note           String?
  awardedById    String
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("awards")
}

model OffboardingChecklistItem {
  id             String        @id @default(cuid())
  organizationId String
  label          String
  area           ClearanceArea
  // Plain nullable column, deliberately off the relation graph (cf. PostingApprover).
  departmentId   String?
  order          Int
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("offboarding_checklist_items")
}

model LeaveRequest {
  id              String             @id @default(cuid())
  employeeId      String
  leaveTypeId     String
  startDate       DateTime
  endDate         DateTime
  totalDays       Decimal            @db.Decimal(5, 2)
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_requests")
}

// ─── Requests & Multi-Stage Approvals (T168/T169) ────────────────────────────
// Unified request across 7 types (Employee Kiosk). Type-specific detail lives in
// `payload` (validated by a Zod discriminatedUnion); dateFrom/dateTo/hours/status
// are promoted for the hot query paths (approval inbox, OT lookup, dashboards).

model Request {
  id           String        @id @default(cuid())
  employeeId   String
  type         RequestType
  status       RequestStatus @default(PENDING)
  dateFrom     DateTime?
  dateTo       DateTime?
  hours        Decimal?      @db.Decimal(6, 2)
  reason       String?
  payload      Json
  currentStage Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employee  Employee          @relation(fields: [employeeId], references: [id])
  steps     ApprovalStep[]
  documents RequestDocument[]

  @@index([employeeId, status])
  @@index([type, status, dateFrom])
  @@map("requests")
}

model ApprovalStep {
  id           String            @id @default(cuid())
  // Polymorphic subject (#134): exactly one of requestId / timesheetId / payrollRunId is
  // set. The same maker-checker chain drives requests, timesheets, and payroll runs.
  requestId    String?
  timesheetId  String?
  payrollRunId String?
  // Re-file preserves prior steps append-only (#134): each refile bumps `attempt`,
  // so the chain history groups by attempt. stageIndex is 0..2 within an attempt.
  attempt      Int               @default(1)
  stageIndex   Int
  stageKind    ApprovalStageKind
  stage        ApprovalStage     @default(APPROVE)
  role         Role? // set when stageKind = ROLE (approver group)
  requiredRole Role? // the role that may act on this stage (#134) — MAKE/VERIFY/APPROVE
  decision     ApprovalDecision? // null = pending
  actorId      String?
  note         String?
  decidedAt    DateTime?
  createdAt    DateTime          @default(now())

  request    Request?    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  timesheet  Timesheet?  @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  actor      User?       @relation(fields: [actorId], references: [id])

  @@unique([requestId, attempt, stageIndex])
  @@unique([timesheetId, attempt, stageIndex])
  @@unique([payrollRunId, attempt, stageIndex])
  @@map("approval_steps")
}

// Supporting docs for a request. Bytes live on disk under UPLOAD_DIR (same store
// as EmployeeDocument, T162) and are served only through an authenticated download
// route. `verifiedById`/`verifiedAt` record an approver signing off on the document
// as part of the review flow (issue #51).
//
// #283/D11: the two columns do NOT mean the same thing. `verifiedAt` means currently verified;
// `verifiedById` is the durable record of who last signed off and SURVIVES clearing, because the
// F3 separation-of-duties bar keys on it. Nulling both on an un-verify reopens a one-click bypass.
//
// #299: rows here are NEVER deleted. Removing a document sets `deletedAt` (a tombstone) and keeps
// every fact about it — including `verifiedById` — forever, because a hard delete erased the column
// the F3 bar reads and let the un-verify -> delete -> re-upload sequence launder a signature away.
// Only the BYTES may go: `storageKey` is nulled once evicted. Readers are split DELIBERATELY —
// EIGHT must INCLUDE tombstones (decide()'s F3 read, the pending-queue SoD, actBlockedReason, the
// Removed-documents history panel, the request-delete sweep, both storage scripts, and #164's
// backup collector) and four must EXCLUDE them (download list, upload cap, approvals chip,
// detail-page live list). A uniform `where: { deletedAt: null }` reopens the bypass with every
// test green. See
// process/general-plans/.../soft-delete-request-documents-299_PLAN_12-08-26.md for the reader table.
//
// #164: the backup collector INCLUDES tombstones on purpose. A tombstoned row whose bytes are
// still on disk still owns a file that must be backed up — the same reasoning that keeps
// sweep-orphan-uploads.ts unfiltered (#299/AC-7). A tombstoned row whose `storageKey` is already
// NULL has no bytes to copy, and is recorded in the manifest's `skipped` list rather than dropped,
// so a restorer can see the row existed and why nothing was saved for it.
model RequestDocument {
  id           String    @id @default(cuid())
  requestId    String
  label        String
  fileName     String // original upload filename
  mimeType     String
  size         Int // bytes
  storageKey   String? // path relative to UPLOAD_DIR; null once the bytes are evicted (#299/D-4)
  uploadedAt   DateTime  @default(now())
  verifiedById String?
  verifiedAt   DateTime?
  // #299: BOTH the tombstone flag and the FIFO ordering key. The row is never deleted; eviction
  // walks tombstones oldest-`deletedAt`-first, which is not the same order as `uploadedAt` once
  // documents are swapped out of upload order.
  deletedAt    DateTime?

  request    Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation("RequestDocumentVerifier", fields: [verifiedById], references: [id])

  @@index([requestId])
  // #299: tombstones are kept forever and are unbounded, so every eviction pass filters and sorts
  // on deletedAt. Also the greppable declaration that deletedAt IS a query dimension here.
  @@index([requestId, deletedAt])
  @@map("request_documents")
}

// ─── Employee Documents (201 file uploads — T162) ────────────────────────────
// Sensitive HR files (contracts, IDs, exit docs). Bytes live on disk under
// UPLOAD_DIR (never in static/); this row holds metadata + the storageKey and is
// served only through an authenticated download route.

enum EmployeeDocumentCategory {
  CONTRACT
  GOVERNMENT_ID
  RESUME
  PAYROLL_FORM
  EXIT_DOCUMENT
  OTHER
}

model EmployeeDocument {
  id           String                   @id @default(cuid())
  employeeId   String
  category     EmployeeDocumentCategory @default(OTHER)
  label        String
  fileName     String // original upload filename
  mimeType     String
  size         Int // bytes
  storageKey   String // path relative to UPLOAD_DIR
  uploadedById String?
  uploadedAt   DateTime                 @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([employeeId])
  @@map("employee_documents")
}

// ─── Document backup (#164) ──────────────────────────────────────────────────
// Document BYTES live only on local disk under UPLOAD_DIR — never in Postgres — so a
// pg_dump backs up every document ROW and none of the files. These two models drive a
// nightly cron script (scripts/backup-documents.ts) that copies the files to a second
// location and writes a manifest describing them.
//
// Config is per-organization, not global, for two reasons: the settings page that edits it
// is already tenant-scoped (a singleton could not be edited there without letting one
// tenant set another's schedule), and the backup tree is partitioned by organizationId so
// "restore one tenant" is a directory, not a filter someone has to remember to apply.
//
// CREDENTIALS ARE NOT HERE AND MUST NEVER BE. Endpoint, region, bucket, access key and
// secret come from the environment (BACKUP_S3_*). What is stored is only the KIND of
// destination. A database dump therefore cannot leak the bucket, and the settings page has
// no secret to render.

enum BackupDestinationKind {
  LOCAL
  S3
}

enum BackupRunStatus {
  // Written before the first byte. A row left in this state means the process died — the
  // stale-run sweep at the start of the next run flips it to FAILED, unless the destination
  // already holds a manifest.json, in which case only the status write was lost (#164/E-08).
  RUNNING
  SUCCESS
  // Some files could not be read or written. Deliberately NOT a failure state: the backup
  // that was taken is real and worth keeping, and a silent SUCCESS over unreadable files is
  // exactly the lie this model exists to prevent.
  PARTIAL
  FAILED
}

model BackupConfig {
  id              String                @id @default(cuid())
  organizationId  String                @unique
  // Master switch. Off → the nightly script skips this org entirely and records nothing.
  enabled         Boolean               @default(false)
  // "Every # days" from #164. 1 = every night. Measured from the last COMPLETED run
  // (SUCCESS or PARTIAL), not from the last attempt — a failed run must not push the next
  // one a full interval away. Bounded 1–90 at every writer.
  intervalDays    Int                   @default(1)
  // How many completed runs to keep. Pruning happens AFTER a run completes, never before,
  // so a crash mid-run cannot cost the newest good backup. Bounded 1–30 at every writer.
  retentionCount  Int                   @default(7)
  destinationKind BackupDestinationKind @default(LOCAL)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("backup_configs")
}

model BackupRun {
  id              String                @id @default(cuid())
  organizationId  String
  // Directory / key prefix name, e.g. "2026-08-22T023000Z-a1b2". Also the ONLY thing the
  // settings page shows about location — never an absolute path, never a bucket name.
  runId           String
  status          BackupRunStatus
  destinationKind BackupDestinationKind
  startedAt       DateTime              @default(now())
  finishedAt      DateTime?
  // Counts, not lists: the per-file detail lives in the backup's own manifest.json, which
  // is the artifact a restorer actually has. Storing filenames here would put document
  // names (which are user-supplied and sometimes sensitive) in a second place for no gain.
  fileCount       Int                   @default(0)
  skippedCount    Int                   @default(0)
  failedCount     Int                   @default(0)
  // The only BigInt in this schema. src/hooks.ts transports Decimal, not BigInt, so the
  // settings service MUST convert this to a plain number before it reaches a load()
  // — mixing a BigInt with a number in client-side formatting throws (#164/E-15).
  totalBytes      BigInt                @default(0)
  // sha256 of the serialized manifest. Lets an operator confirm the manifest on the
  // destination is the one this run wrote.
  manifestSha256  String?
  // Operator-facing reason for FAILED/PARTIAL. SANITIZED before storage: never an absolute
  // path, never a bucket/endpoint, never a credential — this string is rendered in the UI.
  error           String?               @db.VarChar(500)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The history table reads newest-first per org; retention pruning reads completed runs
  // per org in the same order. Both are covered by this one index.
  @@index([organizationId, startedAt])
  @@map("backup_runs")
}

// ─── Separation / Offboarding (FR-072 / T180) ────────────────────────────────
// A resignation/termination case: records the reason, drives a clearance
// checklist, and snapshots the computed final pay before the employee is set to
// OFFBOARDED. Only one non-finalized case per employee at a time (enforced in
// the service, not the schema, so a re-hire can later be separated again).

enum SeparationType {
  RESIGNATION
  TERMINATION
}

enum SeparationStatus {
  OPEN // clearance in progress
  CLEARED // every clearance item signed off — ready to finalize
  FINALIZED // final pay snapshotted, employee set to OFFBOARDED
}

enum ClearanceStatus {
  PENDING
  CLEARED
}

// Who signs a clearance step off (#306). A closed vocabulary: free text made items
// unroutable on a typo, and "Immediate Supervisor" is not a department at all.
enum ClearanceArea {
  IT
  HR
  ADMIN
  FINANCE
  IMMEDIATE_SUPERVISOR
}

model SeparationRecord {
  id                String           @id @default(cuid())
  organizationId    String
  employeeId        String
  type              SeparationType
  status            SeparationStatus @default(OPEN)
  effectiveDate     DateTime
  reason            String?
  // Final-pay snapshot — computed at finalize, null until then.
  finalPayAmount    Decimal?         @db.Decimal(12, 2)
  finalPayBreakdown Json?
  finalizedAt       DateTime?
  finalizedById     String?
  // Everything finalize is about to overwrite, captured inside finalize's transaction so #304's
  // undo can put it back. NULL = finalized before #304 shipped ⇒ the money cannot be restored
  // (D-4, "partially restored").
  preFinalizeState  Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  employee       Employee        @relation(fields: [employeeId], references: [id])
  clearanceItems ClearanceItem[]

  @@index([organizationId])
  @@index([employeeId])
  @@map("separation_records")
}

model ClearanceItem {
  id                    String          @id @default(cuid())
  separationId          String
  label                 String
  area                  ClearanceArea
  // Plain nullable column, deliberately off the relation graph (cf. PostingApprover).
  departmentId          String?
  status                ClearanceStatus @default(PENDING)
  clearedById           String?
  // #304/B-2: the #297 separation-of-duties bar, parked where the ordinary un-clear path cannot
  // reach it. WRITTEN ONLY by undoSeparation's re-open branch. setClearanceItem must never write
  // or clear this field — that is the entire point: clearedById is NULLable by any MANAGE_HR
  // holder, this is not.
  previouslyClearedById String?
  clearedAt             DateTime?
  notes                 String?

  separation SeparationRecord @relation(fields: [separationId], references: [id], onDelete: Cascade)

  @@index([separationId])
  @@map("clearance_items")
}

// ─── Announcements & Notifications (T182) ────────────────────────────────────

model Announcement {
  id             String   @id @default(cuid())
  organizationId String
  authorId       String?
  title          String
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  author       User?        @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@index([organizationId, createdAt])
  @@map("announcements")
}

// What a notification is about, so the activity feed can label it with an icon rather than
// smuggling one into the message text as an emoji. GENERAL is the fallback for rows written
// before this existed and for events that fit no bucket.
enum NotificationKind {
  GENERAL
  ANNOUNCEMENT
  AWARD
  PAYSLIP
  REQUEST
  RECRUITMENT
  PERFORMANCE
}

// Per-user in-app notification. Surfaced as a toast on next load; readAt set once seen.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  message   String
  kind      NotificationKind @default(GENERAL)
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ─── Public Holidays ──────────────────────────────────────────────────────────

model PublicHoliday {
  id             String      @id @default(cuid())
  organizationId String
  date           DateTime
  name           String
  type           HolidayType
  year           Int

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("public_holidays")
}

// ─── Payroll ──────────────────────────────────────────────────────────────────

model PayrollConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  payFrequency   PayFrequency @default(SEMI_MONTHLY)
  firstCutoff    Int?
  secondCutoff   Int?
  sssTable       Json
  // #220: statutory RATE fields removed — StatutoryRateConfig is now the authoritative,
  // seeded source of PhilHealth/Pag-IBIG/SSS/BIR figures. This config keeps only frequency,
  // cutoffs, and the (legacy, unused-by-engine) sssTable/birTaxTable placeholders.
  birTaxTable    Json
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("payroll_configs")
}

model PayrollRun {
  id              String           @id @default(cuid())
  organizationId  String
  periodId        String?
  periodStart     DateTime
  periodEnd       DateTime
  status          PayrollRunStatus @default(DRAFT)
  totalGross      Decimal          @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal          @default(0) @db.Decimal(14, 2)
  totalNet        Decimal          @default(0) @db.Decimal(14, 2)
  hasOverride     Boolean          @default(false)
  overrideNote    String?
  // LANDMINE (#298): before #298 THREE call sites wrote this field — the finance approver
  // (`services/approvals.ts` `decidePayrollRun`), `approvePayroll` in `services/payroll/index.ts`,
  // and *also* whoever LOCKED the period (`services/payroll/periods.ts` `lock`). A row written
  // before #298 therefore means "approver OR locker, whichever wrote last", and those rows were
  // deliberately NOT backfilled. From #298 the lock no longer writes it and the field means the
  // approver only; the lock actor lives on `PayrollPeriod.lockedById`.
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  period        PayrollPeriod? @relation(fields: [periodId], references: [id])
  entries       PayrollEntry[]
  approvalSteps ApprovalStep[]

  @@unique([organizationId, periodStart, periodEnd])
  @@map("payroll_runs")
}

model PayrollEntry {
  id              String  @id @default(cuid())
  payrollRunId    String
  employeeId      String
  hoursWorked     Decimal @db.Decimal(6, 2)
  basicPay        Decimal @db.Decimal(12, 2)
  grossPay        Decimal @db.Decimal(12, 2)
  sssEe           Decimal @db.Decimal(10, 2)
  sssEr           Decimal @db.Decimal(10, 2)
  philhealthEe    Decimal @db.Decimal(10, 2)
  philhealthEr    Decimal @db.Decimal(10, 2)
  pagibigEe       Decimal @db.Decimal(10, 2)
  pagibigEr       Decimal @db.Decimal(10, 2)
  withholdingTax  Decimal @db.Decimal(10, 2)
  totalDeductions Decimal @db.Decimal(12, 2)
  netPay          Decimal @db.Decimal(12, 2)
  isFlagged       Boolean @default(false)
  flagReason      String?

  payrollRun PayrollRun         @relation(fields: [payrollRunId], references: [id])
  employee   Employee           @relation(fields: [employeeId], references: [id])
  earnings   PayrollEarning[]
  deductions PayrollDeduction[]

  @@map("payroll_entries")
}

// ─── Recruitment ──────────────────────────────────────────────────────────────

model JobPosting {
  id              String           @id @default(cuid())
  organizationId  String
  departmentId    String
  title           String
  description     String           @db.Text
  status          JobPostingStatus @default(DRAFT)
  postedAt        DateTime?
  closedAt        DateTime?
  createdById     String
  // Approval trail (#195): who submitted for approval, who approved, and the reason a
  // posting was sent back to draft. All null on a fresh draft.
  submittedById   String?
  approvedById    String?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  department   Department          @relation(fields: [departmentId], references: [id])
  applicants   Applicant[]
  channels     JobPostingChannel[]

  @@map("job_postings")
}

// Per-department posting approver (#195). A job posting must be approved before it goes
// OPEN; this maps each department to the employee who signs off its postings (e.g. the
// Senior Developer for Software Developers). Departments with no mapping fall back to HR
// in the service. A plain employee-id FK (resolved in queries) keeps the config table off
// the Employee/Department relation graph.
model PostingApprover {
  id             String   @id @default(cuid())
  organizationId String
  departmentId   String
  approverId     String // Employee.id who approves this department's postings
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, departmentId])
  @@index([organizationId])
  @@map("posting_approvers")
}

// Where a posting was published (#117). A manual tracking checklist — NOT an API
// integration. Mirrors the DeductionType/EmployeeDeduction split: JobBoard is the
// org catalog, JobPostingChannel is the per-posting assignment.
enum JobChannelStatus {
  NOT_POSTED
  POSTED
  EXPIRED
  TAKEN_DOWN
}

// Org-scoped catalog of job boards (JobStreet, Indeed, LinkedIn, …). Deactivate rather
// than delete so historical postings keep their context (same reasoning as DeductionType).
model JobBoard {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  channels     JobPostingChannel[]

  @@unique([organizationId, name])
  @@map("job_boards")
}

// One row per (posting, board). Ticking a board on the posting creates/reactivates a
// POSTED row; unticking flips it to TAKEN_DOWN (with takenDownAt) rather than deleting,
// so the history of where a role was advertised survives.
model JobPostingChannel {
  id           String           @id @default(cuid())
  jobPostingId String
  jobBoardId   String
  status       JobChannelStatus @default(POSTED)
  url          String?
  postedAt     DateTime?
  takenDownAt  DateTime?
  postedById   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  jobBoard   JobBoard   @relation(fields: [jobBoardId], references: [id])

  @@unique([jobPostingId, jobBoardId])
  @@index([jobPostingId])
  @@map("job_posting_channels")
}

model Applicant {
  id                    String         @id @default(cuid())
  jobPostingId          String
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  resumeUrl             String?
  coverLetter           String?        @db.Text
  currentStage          ApplicantStage @default(APPLIED)
  convertedToEmployeeId String?        @unique
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  jobPosting        JobPosting              @relation(fields: [jobPostingId], references: [id])
  convertedEmployee Employee?               @relation("ConvertedEmployee", fields: [convertedToEmployeeId], references: [id])
  stageHistory      ApplicantStageHistory[]
  interviews        Interview[]
  offer             Offer?

  @@map("applicants")
}

model ApplicantStageHistory {
  id          String         @id @default(cuid())
  applicantId String
  stage       ApplicantStage
  notes       String?
  changedById String
  changedAt   DateTime       @default(now())

  applicant Applicant @relation(fields: [applicantId], references: [id])

  @@map("applicant_stage_history")
}

// Scheduled interview + post-interview feedback for an applicant (FR-068).
model Interview {
  id          String        @id @default(cuid())
  applicantId String
  scheduledAt DateTime
  mode        InterviewMode @default(ONSITE)
  interviewer String // interviewer name(s)
  location    String? // room, address, or video link
  feedback    String?       @db.Text // recorded after the interview
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("interviews")
}

// A job offer issued to an applicant; acceptance feeds straight into onboarding (FR-069).
model Offer {
  id            String      @id @default(cuid())
  applicantId   String      @unique
  jobTitle      String
  departmentId  String?
  monthlySalary Decimal     @db.Decimal(12, 2)
  startDate     DateTime
  status        OfferStatus @default(SENT)
  notes         String?     @db.Text
  createdById   String
  createdAt     DateTime    @default(now())
  respondedAt   DateTime?

  applicant  Applicant   @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])

  @@map("offers")
}

// ─── Inventory (#114) ─────────────────────────────────────────────────────────
//
// A simple org-scoped asset/equipment/supplies registry. v1 is pure tracking — no
// barcodes, purchase orders, or stock-level alerts. An item may be assigned to an
// employee (which ties into the 201 file / offboarding clearance later).
enum InventoryStatus {
  IN_STOCK
  ASSIGNED
  RETIRED
}

model InventoryItem {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  category       String
  quantity       Int             @default(1)
  unit           String          @default("pc")
  location       String?
  status         InventoryStatus @default(IN_STOCK)
  // Set only when status is ASSIGNED. SetNull so retiring an employee doesn't delete
  // the asset row — it just becomes unassigned.
  assignedToId   String?
  serialNumber   String?
  value          Decimal?        @db.Decimal(12, 2)
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  assignedTo   Employee?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([assignedToId])
  @@map("inventory_items")
}

// ─── Branches ─────────────────────────────────────────────────────────────────
//
// A food-service tenant's physical stores (JoJo Potato / Sweetleaf outlets). NOTE ON THE
// WORD: in this codebase a "branch" is THIS — a store. Older comments used it loosely for
// the tenant itself; those say "tenant" now.
//
// Branches are CLOSED, never deleted, because Employee rows point at them (same reasoning
// as JobBoard.isActive). Closing keeps the roster — a filled store's crew stays on record —
// and only clears the manager.
enum BranchStatus {
  OPEN
  CLOSED
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String       @db.VarChar(120)
  // The store's own street address. Organization.address stays the tenant's HQ address.
  address        String?
  contactPhone   String?
  status         BranchStatus @default(OPEN)
  // Branch manager, always a member of this branch's own roster — naming them assigns them
  // (see resolveBranchManager). SetNull so removing an employee never deletes the store.
  managerId      String?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  manager      Employee?    @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees    Employee[]   @relation("BranchRoster")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("branches")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String
  // `actorRoles` records the actor's whole role set as held at the time of the action —
  // unlike the `actor` relation, which always shows today's roles. It replaced the scalar
  // `actorRole` in #282.
  actorRoles     Role[]      @default([])
  action         AuditAction
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User         @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

// ─── Time Tracking ────────────────────────────────────────────────────────────
// Raw IN/OUT punches (e.g. from the Discord bot). Timestamps are stored in UTC
// (timestamptz); day/week bucketing is done in Philippine Standard Time (UTC+8)
// by the aggregation service. A punch is linked to a Timesheet once aggregated.

model TimeLog {
  id                 String      @id @default(cuid())
  employeeId         String
  punchType          PunchType
  source             PunchSource @default(DISCORD)
  timestamp          DateTime    @db.Timestamptz(3)
  discordMessageId   String?
  // #200 — deterministic idempotency key for punches that have no Discord message to key on.
  // `backlog:<employeeNumber>:<YYYY-MM-DD>:<slot>` for a CSV backlog import row. Null for every
  // Discord punch, which keeps using discordMessageId. Same two-layer defence as #99: an
  // app-level bulk pre-check for a clean message, plus the unique constraint below to close the
  // concurrent race. Postgres treats NULL as distinct in a unique index, so the existing
  // null-keyed rows do not collide — the same property @@unique([discordMessageId, employeeId])
  // already relies on.
  dedupKey           String?
  // #177 — captured from navigator.geolocation at the moment of a WEB punch, and only there.
  // Null for every DISCORD and MANUAL punch by construction: `recordPunch` writes these four
  // only when its caller passes a `location`, and the Discord route and the backlog importer
  // never do. Sensitive personal data — readable only through
  // GET /api/v1/timesheets/:employeeId/punches (gated by `canTouchEmployee`: owner, their
  // manager, branch manager, org HR) and the employee's own /punch page. Never in the audit
  // log (#242), never in the attendance CSV export. Retention follows the TimeLog row itself —
  // no separate purge window.
  //
  // Float (double precision), never Decimal: these are not money and are never summed, so the
  // Decimal transport hook in src/hooks.ts stays out of the picture entirely.
  latitude           Float?
  longitude          Float?
  locationAccuracyM  Float?
  // Timestamptz like `timestamp` above, not a naive `timestamp(3)`: two time columns on one
  // punch row must not disagree about what a time means when the whole app runs in Manila time.
  locationCapturedAt DateTime?   @db.Timestamptz(3)
  note               String?
  timesheetId        String?
  createdAt          DateTime    @default(now())

  employee  Employee   @relation(fields: [employeeId], references: [id])
  timesheet Timesheet? @relation(fields: [timesheetId], references: [id])

  @@unique([discordMessageId, employeeId])
  @@unique([dedupKey, employeeId])
  @@index([employeeId, timestamp])
  @@index([timesheetId])
  @@map("time_logs")
}

// ─── Benefits Administration ──────────────────────────────────────────────────

model BenefitPlan {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  type           BenefitPlanType
  provider       String?
  description    String?         @db.Text
  employeeCost   Decimal?        @db.Decimal(12, 2)
  employerCost   Decimal?        @db.Decimal(12, 2)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  enrollments  BenefitEnrollment[]

  @@map("benefit_plans")
}

model BenefitEnrollment {
  id            String                  @id @default(cuid())
  employeeId    String
  benefitPlanId String
  status        BenefitEnrollmentStatus @default(ACTIVE)
  coverageLevel String?
  effectiveDate DateTime
  endedAt       DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  employee Employee    @relation(fields: [employeeId], references: [id])
  plan     BenefitPlan @relation(fields: [benefitPlanId], references: [id])

  @@unique([employeeId, benefitPlanId])
  @@map("benefit_enrollments")
}

// ─── Performance Management ───────────────────────────────────────────────────

model ReviewCycle {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         ReviewCycleStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  reviews      PerformanceReview[]

  // #178: the generator is offered a run by cron and decides for itself whether one is due.
  // A double-create is prevented at the DATABASE, not by the script's own care — the cheapest
  // correct option, and the same shape PayrollRun already uses. Column names are deliberately
  // left as startDate/endDate rather than renamed to periodStart/periodEnd: a rename would
  // touch every existing reader and both surviving unit tests for no gain.
  @@unique([organizationId, startDate, endDate])
  @@index([organizationId, status])
  @@map("review_cycles")
}

model PerformanceReview {
  id                   String       @id @default(cuid())
  cycleId              String
  employeeId           String
  reviewerId           String
  status               ReviewStatus @default(PENDING)
  selfAssessment       String?      @db.Text
  managerComments      String?      @db.Text
  overallRating        Int?
  submittedAt          DateTime?
  completedAt          DateTime?
  acknowledgedAt       DateTime?
  // #178: the template's `structure`, copied verbatim inside the SAME transaction that creates
  // this review, and NEVER re-read from PerformanceTemplate afterwards. Editing a template, or
  // reassigning the employee, must not change what a resolved review shows. Precedent:
  // SeparationRecord.preFinalizeState, also captured inside its own transaction.
  templateSnapshot     Json?
  // Kept alongside the snapshot for provenance/reporting only. NEVER read to render the form —
  // reading it would defeat the snapshot.
  templateId           String?
  // Everything the EVALUATOR types or picks, keyed by the snapshot's criterion/section/band ids.
  // Every value here is stored verbatim; none is derived. Nulled wholesale by the redaction gate
  // — which is exactly why no employee-authored content may ever live in here.
  answers              Json?
  // Employee-authored, its OWN column, never inside `answers`. This is the paper form's
  // "Employee Comments" field and it is ALWAYS visible to the employee. Distinct from
  // `selfAssessment`, which is the app-only pre-scoring stage.
  employeeComments     String?      @db.Text
  // The explicit HR RELEASE. Null = the employee's view is redacted. Set = released.
  // Attribution is on the row so the audit trail and the gate cannot disagree.
  //
  // The attribution is the releasing HR user's EMPLOYEE row, not their User row — the FK below
  // points at `employees(id)`. It is an Employee because the UI renders "Released by
  // {firstName} {lastName}" through the `releasedBy` relation, and `User` carries no name
  // fields. Callers pass a User id and MUST resolve it to that user's employee row first
  // (see `releaseReview` in src/lib/server/services/performance.ts). An HR user with no
  // employee record releases with null attribution; the audit row still names the actor.
  releasedAt           DateTime?
  releasedByEmployeeId String?
  // Reminder de-duplication. The reminder job runs several times a day; without these it would
  // send the same nudge every run.
  lastReminderAt       DateTime?
  lastReminderKind     String?      @db.VarChar(40)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  cycle      ReviewCycle     @relation(fields: [cycleId], references: [id])
  employee   Employee        @relation("ReviewSubject", fields: [employeeId], references: [id])
  reviewer   Employee        @relation("Reviewer", fields: [reviewerId], references: [id])
  releasedBy Employee?       @relation("ReviewReleasedBy", fields: [releasedByEmployeeId], references: [id])
  signoffs   ReviewSignoff[]

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([reviewerId])
  @@index([status])
  @@map("performance_reviews")
}

// ─── Performance Evaluation Templates (#178) ─────────────────────────────────

// An HR-authored evaluation form, stored as one JSON document.
//
// JSON rather than a Template→Section→Criterion relational tree because the whole document
// is read and written as a unit, is never queried by its interior, and must be snapshotted
// verbatim onto a review. Precedent in this schema: StatutoryRateConfig.sssTable /
// birTaxTable. The cost accepted in exchange: Postgres enforces NOTHING about
// `structure`, so EVERY writer must go through the shared zod schema in
// src/lib/server/performance/schemas.ts. A missed validation here is silent corruption with
// no database backstop.
//
// NOTHING in `structure` is a calculation input. Section weights, section maxima and band
// ranges are what the form PRINTS. `maximum` and `totalCeiling` are additionally read by the
// range VALIDATOR (accept/reject only). No code sums, weights, or derives anything. See #178
// SPEC acceptance criterion 4.
model PerformanceTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String   @db.VarChar(200)
  isActive       Boolean  @default(true)
  structure      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id])
  assignedEmployees Employee[]   @relation("AssignedTemplate")

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("performance_templates")
}

// One signatory's attestation on one review. THE ONLY relational exception in this feature's
// data model.
//
// Everything else about a review is one-writer-at-a-time and lives in JSON. Sign-off is not:
// four different actors race to attest on the same review, and the sequential rule must be
// enforced against a value two of them may be reading at the same instant. A JSON array on
// PerformanceReview would need read-modify-write, which loses one of two concurrent
// attestations. @@unique([reviewId, slotId]) makes the race a P2002 the service can report,
// not a silently dropped signature.
model ReviewSignoff {
  id               String   @id @default(cuid())
  reviewId         String
  // Matches templateSnapshot.signatoryOrder[].id — NOT a foreign key, because the slot lives
  // inside the snapshot JSON. The snapshot is immutable, so the id is stable for this review's
  // whole life.
  slotId           String
  // Denormalized from the snapshot so a signature renders without re-reading the snapshot.
  roleLabel        String   @db.VarChar(120)
  // Position in the snapshot's signatoryOrder at attest time. Stored for rendering and for
  // ordering the signature block; the turn CHECK still derives from the snapshot, never from
  // this column.
  order            Int
  attestedByUserId String
  typedName        String   @db.VarChar(200)
  attestedAt       DateTime @default(now())

  review     PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  attestedBy User              @relation(fields: [attestedByUserId], references: [id])

  @@unique([reviewId, slotId])
  @@index([reviewId])
  @@map("review_signoffs")
}

// Per-organization review cadence. Mirrors BackupConfig: a row is created lazily
// by the settings page, and its absence means "use the defaults", so the cron never creates
// configuration as a side effect of running.
model PerformanceConfig {
  id             String   @id @default(cuid())
  organizationId String   @unique
  // Master switch. Off → the generator skips this org entirely.
  enabled        Boolean  @default(true)
  // "Every # months". Default 2 = the bi-monthly cadence #178 asks for. Bounded 1-24 at every
  // writer. Changing it NEVER rewrites an existing ReviewCycle row.
  intervalMonths Int      @default(2)
  // Days after a review opens before it counts as overdue. Drives the reminder job only.
  dueDays        Int      @default(14)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("performance_configs")
}

// ─── Org Structure (Positions) ────────────────────────────────────────────────
// Lightweight job/role catalog backing org charts. Org hierarchy otherwise
// reuses Department.parentDepartmentId and Employee.reportsToId; role management
// edits User.roles (audited) — no dedicated RBAC table.

model Position {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  departmentId   String?
  salaryGradeId  String?
  level          Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  salaryGrade  SalaryGrade? @relation(fields: [salaryGradeId], references: [id])
  employees    Employee[]

  @@unique([organizationId, title])
  @@map("positions")
}

// Pay grade / band assignable to positions. An employee inherits their band via
// their position; HR is warned when a basic salary falls outside [min, max] (T163).
model SalaryGrade {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  minSalary      Decimal  @db.Decimal(12, 2)
  midSalary      Decimal  @db.Decimal(12, 2)
  maxSalary      Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  positions    Position[]

  @@unique([organizationId, name])
  @@map("salary_grades")
}

// ─── Payroll Expansion (Phase 11 — FR-060–FR-066) ─────────────────────────────
// Period lifecycle wraps the existing PayrollRun; earnings/deductions are itemized
// line items on PayrollEntry; premium multipliers + earning/deduction codes are
// configurable; loans and cash advances amortize per run.

model PayrollPeriod {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  cutoff         Int?
  status         PayrollPeriodStatus @default(OPEN)
  lockedAt       DateTime?
  releasedAt     DateTime?
  // #298: who locked / who released. Nullable because these record only what happened after
  // #298 — NULL means the period predates the column, never "nobody locked it". Bare ids, not
  // a `User` relation, so the column add stays metadata-only on a populated database (no FK to
  // validate, no back-relation on User). `AuditLog.actorId` is the precedent.
  lockedById     String?
  releasedById   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  runs         PayrollRun[]

  @@map("payroll_periods")
}

model PayrollEarning {
  id             String  @id @default(cuid())
  payrollEntryId String
  code           String
  label          String
  amount         Decimal @db.Decimal(12, 2)
  taxable        Boolean @default(true)

  entry PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)

  @@index([payrollEntryId])
  @@map("payroll_earnings")
}

model PayrollDeduction {
  id             String  @id @default(cuid())
  payrollEntryId String
  code           String
  label          String
  amount         Decimal @db.Decimal(12, 2)
  refId          String?

  entry PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)

  @@index([payrollEntryId])
  @@map("payroll_deductions")
}

model EarningType {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  label          String
  taxable        Boolean  @default(true)
  multiplier     Decimal? @db.Decimal(6, 4)
  isActive       Boolean  @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@map("earning_types")
}

model DeductionType {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  label          String
  isStatutory    Boolean @default(false)
  isActive       Boolean @default(true)

  organization Organization        @relation(fields: [organizationId], references: [id])
  assignments  EmployeeDeduction[]

  @@unique([organizationId, code])
  @@map("deduction_types")
}

// Recurring monthly deduction HR assigns to an employee, referencing a custom
// DeductionType from Settings → Pay Codes (#66). computePayroll prorates the
// monthly amount to the period (like statutory contributions) and applies it as
// a fixed deduction line ahead of loan/cash-advance amortization. Statutory
// codes can't be assigned — those are computed automatically. Deactivate
// (isActive=false) instead of deleting so past payslips keep context.
model EmployeeDeduction {
  id              String   @id @default(cuid())
  employeeId      String
  deductionTypeId String
  label           String?
  monthlyAmount   Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deductionType DeductionType @relation(fields: [deductionTypeId], references: [id])

  @@index([employeeId])
  @@map("employee_deductions")
}

model PayRateRule {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  overtime        Decimal  @default(1.25) @db.Decimal(6, 4)
  overtimePremium Decimal  @default(1.30) @db.Decimal(6, 4)
  nightDiff       Decimal  @default(0.10) @db.Decimal(6, 4)
  restDay         Decimal  @default(1.30) @db.Decimal(6, 4)
  regularHoliday  Decimal  @default(2.00) @db.Decimal(6, 4)
  specialHoliday  Decimal  @default(1.30) @db.Decimal(6, 4)
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("pay_rate_rules")
}

// Org-scoped overrides for the PH statutory rate tables (#220). Mirrors PayRateRule:
// one optional row per org, overwrite-in-place (NOT effective-dated — approved runs are
// frozen so history lives in the stored payslips). Every column is nullable; a null field
// falls back to the hardcoded default in ph-statutory.ts, so an org with no row (or a row
// with all-null fields) computes byte-for-byte today's statutory numbers. The bracket
// tables are JSON arrays of the SSSBracket[] / TaxBracket[] shapes (open-ended last
// ceiling stored as null, revived to Infinity on read), validated on save.
model StatutoryRateConfig {
  id             String @id @default(cuid())
  organizationId String @unique

  philhealthRate    Decimal? @db.Decimal(6, 4)
  philhealthFloor   Decimal? @db.Decimal(12, 2)
  philhealthCeiling Decimal? @db.Decimal(12, 2)

  pagibigRate Decimal? @db.Decimal(6, 4)
  pagibigCap  Decimal? @db.Decimal(12, 2)

  sssBrackets Json?
  taxBrackets Json?

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("statutory_rate_configs")
}

// #220: HR-propose / CEO-confirm approval trail for statutory rate changes. HR_ADMIN's save
// creates a PENDING proposal (live StatutoryRateConfig unchanged); a CEO/SUPER_ADMIN confirm
// applies the payload to the live config (status APPLIED) or rejects it (REJECTED).
enum StatutoryRateProposalStatus {
  PENDING
  APPLIED
  REJECTED
}

model StatutoryRateProposal {
  id             String                      @id @default(cuid())
  organizationId String
  proposedById   String
  payload        Json // the full proposed rate set (same shape StatutoryRateConfig stores)
  status         StatutoryRateProposalStatus @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime                    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("statutory_rate_proposals")
}

// ─── Action Proposals (#224 Part 2 / #243) ────────────────────────────────────
// Separation of duties for pay writes that must not be unilateral: the initiator files a PENDING
// proposal and a *different* qualified user applies it. Generalizes StatutoryRateProposal, which
// models only two parties (proposer, decider) — here the TARGET is a third, because the same table
// carries both a CEO proposing for themselves (#224) and a manager proposing for a report (#243).
// Who may confirm is derived from that distinction, not stored: see `confirmerCapabilityFor`.
model ActionProposal {
  id               String               @id @default(cuid())
  organizationId   String
  initiatorId      String // User.id who filed it
  targetEmployeeId String // Employee.id the change lands on
  domain           ProposalDomain
  payload          Json // the writer's own input object, re-validated at apply time
  status           ActionProposalStatus @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String? // required on reject, so the initiator knows what to fix
  createdAt        DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  target       Employee     @relation(fields: [targetEmployeeId], references: [id])

  @@index([organizationId, status])
  @@index([targetEmployeeId])
  @@map("action_proposals")
}

enum ProposalDomain {
  COMPENSATION
  PROMOTION
}

enum ActionProposalStatus {
  PENDING
  APPLIED
  REJECTED
}

model Loan {
  id          String     @id @default(cuid())
  employeeId  String
  type        String?
  principal   Decimal    @db.Decimal(12, 2)
  balance     Decimal    @db.Decimal(12, 2)
  installment Decimal    @db.Decimal(12, 2)
  status      LoanStatus @default(ACTIVE)
  startDate   DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employee Employee      @relation(fields: [employeeId], references: [id])
  payments LoanPayment[]

  @@index([employeeId])
  @@map("loans")
}

model LoanPayment {
  id             String   @id @default(cuid())
  loanId         String
  payrollEntryId String?
  amount         Decimal  @db.Decimal(12, 2)
  paidAt         DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  // Idempotency key for the amortization committed at period lock: one payment per
  // (loan, payroll entry). NULL payrollEntryId stays distinct in Postgres, so manual
  // off-payroll payments are unaffected.
  @@unique([loanId, payrollEntryId])
  @@index([loanId])
  @@map("loan_payments")
}

model CashAdvance {
  id          String     @id @default(cuid())
  employeeId  String
  amount      Decimal    @db.Decimal(12, 2)
  balance     Decimal    @db.Decimal(12, 2)
  installment Decimal    @db.Decimal(12, 2)
  status      LoanStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employee Employee             @relation(fields: [employeeId], references: [id])
  payments CashAdvancePayment[]

  @@index([employeeId])
  @@map("cash_advances")
}

// #309: the mirror of LoanPayment. Without it a void credited back the frozen deduction
// line instead of what lock actually took, so a capped payment came back over-credited —
// measured live at ₱300 returned against ₱100 collected.
model CashAdvancePayment {
  id             String   @id @default(cuid())
  cashAdvanceId  String
  payrollEntryId String?
  amount         Decimal  @db.Decimal(12, 2)
  paidAt         DateTime @default(now())

  cashAdvance CashAdvance @relation(fields: [cashAdvanceId], references: [id], onDelete: Cascade)

  // Idempotency key for the amortization committed at period lock: one payment per
  // (advance, payroll entry). NULL payrollEntryId stays distinct in Postgres, so manual
  // off-payroll payments are unaffected.
  @@unique([cashAdvanceId, payrollEntryId])
  @@index([cashAdvanceId])
  @@map("cash_advance_payments")
}

// Recurring monthly earning HR assigns to an employee (allowance or incentive).
// computePayroll prorates the monthly amount to the period (like statutory
// contributions) and feeds the engine's ALLOWANCE / INCENTIVE buckets (#65).
// Deactivate (isActive=false) instead of deleting so past payslips keep context.
enum EmployeeEarningKind {
  ALLOWANCE
  INCENTIVE
}

model EmployeeEarning {
  id            String              @id @default(cuid())
  employeeId    String
  kind          EmployeeEarningKind
  label         String
  monthlyAmount Decimal             @db.Decimal(12, 2)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_earnings")
}

// ─── Attendance (Phase 11.3 — FR-052–FR-055) ──────────────────────────────────
// Work schedules define per-weekday shift windows; AttendanceDay records are derived
// from TimeLog punches + schedule + holidays, reviewed/locked by HR, then summed into
// the payroll engine's AttendanceInput.

model WorkSchedule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  // Per-schedule tardiness switch (#190). ANDs with Organization.trackTardiness; when either is
  // off, employees on this schedule are never marked LATE. Default keeps current behavior.
  trackTardiness Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  days         WorkScheduleDay[]
  employees    Employee[]

  @@map("work_schedules")
}

model WorkScheduleDay {
  id           String @id @default(cuid())
  scheduleId   String
  weekday      Int // 0 = Sunday … 6 = Saturday, in PHT
  startMinutes Int // minutes from midnight (PHT), e.g. 540 = 09:00
  endMinutes   Int
  breakMinutes Int    @default(60)

  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, weekday])
  @@map("work_schedule_days")
}

model AttendanceDay {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  status     AttendanceStatus
  dayType    DayType          @default(REGULAR)
  timeIn     DateTime?
  timeOut    DateTime?

  // #162 — food-service tenants only (isFoodServiceOrg). The AM/PM pair is a DISPLAY split of
  // the same punches `timeIn`/`timeOut` already bracket: amTimeIn === timeIn and
  // pmTimeOut === timeOut whenever a PM block exists. Never read by payroll, reports, or the
  // payslip — those keep reading timeIn/timeOut (first punch / last punch of the day). Null on
  // every non-food-service row and on any day with no second work block.
  amTimeIn  DateTime?
  amTimeOut DateTime?
  pmTimeIn  DateTime?
  pmTimeOut DateTime?

  workedHours           Decimal @default(0) @db.Decimal(5, 2)
  regularHours          Decimal @default(0) @db.Decimal(5, 2)
  overtimeHours         Decimal @default(0) @db.Decimal(5, 2)
  rawOvertimeHours      Decimal @default(0) @db.Decimal(5, 2)
  nightDiffHours        Decimal @default(0) @db.Decimal(5, 2)
  restDayHours          Decimal @default(0) @db.Decimal(5, 2)
  restDayOtHours        Decimal @default(0) @db.Decimal(5, 2)
  regularHolidayHours   Decimal @default(0) @db.Decimal(5, 2)
  regularHolidayOtHours Decimal @default(0) @db.Decimal(5, 2)
  specialHolidayHours   Decimal @default(0) @db.Decimal(5, 2)
  specialHolidayOtHours Decimal @default(0) @db.Decimal(5, 2)
  lateMinutes           Int     @default(0)
  undertimeMinutes      Int     @default(0)
  breakMinutes          Int     @default(0)

  isLocked       Boolean  @default(false)
  // Set when HR hand-corrects a day; keeps re-derive (Refresh) from overwriting the override.
  manuallyEdited Boolean  @default(false)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("attendance_days")
}

// ─── HR Complaints / Inquiries (#112) ────────────────────────────────────────
// A two-way thread HR opens against an employee to ask about an issue (e.g. a
// classification query). HR opens it, the employee responds, HR can reply again,
// and HR marks it resolved. Separate from the approval-based Requests flow.

enum ComplaintStatus {
  OPEN // awaiting the employee's response (freshly opened, or HR replied)
  RESPONDED // the employee has replied; awaiting HR
  RESOLVED // HR closed the thread
}

enum ComplaintCategory {
  CLASSIFICATION // employment classification (hourly/daily/part-time) — a first-class case (#112)
  ATTENDANCE
  CONDUCT
  PERFORMANCE
  OTHER
}

model HrComplaint {
  id             String            @id @default(cuid())
  organizationId String
  employeeId     String // the employee being asked
  openedById     String // the HR user who opened the inquiry
  subject        String
  category       ComplaintCategory @default(OTHER)
  status         ComplaintStatus   @default(OPEN)
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  employee Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  openedBy User                 @relation("ComplaintOpenedBy", fields: [openedById], references: [id])
  messages HrComplaintMessage[]

  @@index([organizationId, status])
  @@index([employeeId, status])
  @@map("hr_complaints")
}

model HrComplaintMessage {
  id          String   @id @default(cuid())
  complaintId String
  authorId    String // the User who wrote this message (HR or the employee)
  body        String
  createdAt   DateTime @default(now())

  complaint HrComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author    User        @relation("ComplaintMessageAuthor", fields: [authorId], references: [id])

  @@index([complaintId, createdAt])
  @@map("hr_complaint_messages")
}
